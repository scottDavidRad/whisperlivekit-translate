# Optional default speech endpoint, preconfigured by the deployment operator.
# Use a reachable LAN/private address; HTTPS app hosting requires wss://.
# A saved app endpoint overrides this client-visible build setting.
VITE_WHISPERLIVEKIT_URL=

# Whisper speech does not need an API key. Optional Conversate providers are
# configured only on the backend: Codex uses its saved login; cloud providers
# may require keys. See server.env.example. Never add provider keys here.
