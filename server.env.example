# Optional AI provider settings for the BACKEND host only.
# Copy this file to server.env, add only the provider settings you need, and
# protect it with chmod 600 server.env. Never put credentials in VITE variables.
# The Mac installer reads server.env as data, never as shell commands. Re-run
# the installer after changing it. It saves provider settings in a private
# .service/provider-env.json file, not in the launchd plist.
# CONVERSATION_PROVIDER=codex

# Codex uses the backend host's saved Codex/ChatGPT login; no API key here.
# Set these only to override the discovered CLI or select an available model.
# CODEX_BIN=
# CODEX_MODEL=

# Grok. The backend supplies its default model when GROK_MODEL is omitted.
XAI_API_KEY=
# GROK_MODEL=

# Qwen. Use a key for the configured Qwen endpoint. The backend supplies the
# default official compatible endpoint and model when these overrides are absent.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=

# Generic OpenAI-compatible provider. Set base URL and model for your service.
# CONVERSATION_BASE_URL=
# CONVERSATION_MODEL=
CONVERSATION_API_KEY=
# OPENAI_API_KEY is a fallback only for the matching official OpenAI host.
OPENAI_API_KEY=
# Enable only for a trusted custom endpoint that deliberately needs no key.
# CONVERSATION_ALLOW_KEYLESS=0

# Optional remembered speakers. Profiles contain local voice embeddings and
# names, never raw recordings. The phone's Remember speakers option enables
# recognition per session; model loading never blocks captions.
# SPEAKER_PROFILES_PATH=~/.local/share/whisperlivekit-translate/speakers.json
# For offline service use, provide an already downloaded TitaNet .nemo file.
# SPEAKER_MODEL_PATH=/absolute/path/to/titanet-l.nemo
# Conservative cosine threshold and best-versus-runner-up margin. Lowering
# these increases the risk of displaying the wrong person's name.
# SPEAKER_MATCH_THRESHOLD=0.75
# SPEAKER_MATCH_MARGIN=0.10
